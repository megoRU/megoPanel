[Unit]
Description=MegoPanel server management panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/megopanel/backend
Environment=MEGOPANEL_CONFIG=/etc/megopanel/config.yaml
ExecStart=/usr/local/bin/megopanel
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077
ReadWritePaths=/opt/megopanel /usr/local/bin /etc/megopanel /var/lib/megopanel /var/backups/megopanel -/var/www -/etc/nginx/sites-available -/etc/nginx/sites-enabled

[Install]
WantedBy=multi-user.target
